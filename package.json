{
  "name": "le-nga-books",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "db:init": "node database/init.mjs",
    "db:backup": "node database/backup.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "build:stem": "node scripts/build-stem.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "pages:dev": "wrangler pages dev dist",
    "pages:admin": "node scripts/pages-admin.mjs",
    "prepages:deploy": "npm run check:pages && npm run build:pages",
    "pages:deploy": "wrangler pages deploy dist",
    "admin:create": "node database/create-admin.mjs",
    "admin:reset": "node database/create-admin.mjs --reset",
    "test": "node --test tests/api.test.mjs tests/runtime.test.mjs tests/deploy.test.mjs tests/customer.test.mjs tests/pages-admin.test.mjs tests/stem.test.mjs",
    "test:ui": "node tests/order-ui.mjs"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.149.0"
  }
}
