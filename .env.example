# For Node hosting only; npm start does not load .env automatically.
# Cloudflare Pages uses D1 bindings and settings in its dashboard.
# NODE_ENV=production
# PUBLIC_ORIGIN=https://books.example.com
# DATABASE_PATH=/persistent-data/landing.sqlite
# TRUST_PROXY=0

# Public Firebase web config for customer login; see FIREBASE.md.
# On Pages, fill the public [vars] section in wrangler.toml.
# FIREBASE_API_KEY=your-firebase-web-api-key
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
